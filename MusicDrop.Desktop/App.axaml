<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicDrop.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6C63FF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20,11" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#17223A" />
      <Setter Property="Foreground" Value="#DDE7FF" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
